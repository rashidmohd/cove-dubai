# Cove Dubai — Next.js front-end environment
#
# Copy to .env.local and fill in real values. NEVER commit real .env files.
#
# Note the two API URLs. They are deliberately separate:
#   - NEXT_PUBLIC_API_URL is baked into the browser bundle and must be the
#     API's PUBLIC address.
#   - INTERNAL_API_URL is used only by Next.js server-side rendering and may be
#     a private address (AWS internal networking). On a laptop and on Railway
#     these are usually the same value; on AWS they typically differ.

# --- API ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000

# --- Site --------------------------------------------------------------------
# Public base URL of this front-end. Used for canonical URLs, hreflang
# alternates, Open Graph tags, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
