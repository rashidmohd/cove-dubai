# Cove Dubai — Express API environment
#
# Copy to .env and fill in real values. NEVER commit .env.
# Every value here is 12-factor config: the same variable names are used on a
# laptop, on Railway, and later on AWS. Only the values differ.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ----------------------------------------------------------------
# Railway Postgres connection string (dev + staging). Later: the RDS endpoint.
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins for the `web` service.
# A wrong value here is the single most common first-deploy failure.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Admin sessions ----------------------------------------------------------
# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
# Idle timeout for an admin session, in minutes.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Cookie attributes are config, not constants — on Railway `web` and `server`
# are different origins so this must be "none" (with SESSION_COOKIE_SECURE=true).
# On AWS, behind one domain with path routing, tighten this to "lax".
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# --- Email (Resend) ----------------------------------------------------------
# Leave EMAIL_API_KEY empty in local dev to use the console transport, which
# logs emails instead of sending them.
EMAIL_API_KEY=
EMAIL_FROM="Cove Dubai <reservations@example.com>"
# Where booking notifications to the hotel itself are sent.
EMAIL_HOTEL_NOTIFICATION_ADDRESS=reservations@example.com

# --- Front-end link building -------------------------------------------------
# Public base URL of the `web` service. Used to build guest-facing links
# (e.g. the secure cancellation link) inside emails.
WEB_BASE_URL=http://localhost:3000
