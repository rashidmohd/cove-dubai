# Cove Dubai — Express API environment
#
# Copy to .env and fill in real values. NEVER commit .env.
# Every value here is 12-factor config: the same variable names are used on a
# laptop, on Railway, and later on AWS. Only the values differ.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ----------------------------------------------------------------
# Railway Postgres connection string (dev + staging). Later: the RDS endpoint.
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins for the `web` service.
# A wrong value here is the single most common first-deploy failure.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Admin sessions ----------------------------------------------------------
# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
# Idle timeout for an admin session, in minutes.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Cookie attributes are config, not constants — on Railway `web` and `server`
# are different origins so this must be "none" (with SESSION_COOKIE_SECURE=true).
# On AWS, behind one domain with path routing, tighten this to "lax".
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# --- Email (Resend) ----------------------------------------------------------
# Leave EMAIL_API_KEY empty in local dev to use the console transport, which
# logs emails instead of sending them.
EMAIL_API_KEY=
EMAIL_FROM="Cove Dubai <reservations@example.com>"
# Where booking notifications to the hotel itself are sent.
EMAIL_HOTEL_NOTIFICATION_ADDRESS=reservations@example.com

# --- Front-end link building -------------------------------------------------
# Public base URL of the `web` service. Used to build guest-facing links
# (e.g. the secure cancellation link) inside emails.
WEB_BASE_URL=http://localhost:3000

# --- Object storage for room photography -------------------------------------
# S3-compatible, deliberately not named after a vendor. Cloudflare R2 today;
# AWS S3 behind CloudFront after the production move — same code, these values
# change. All five together, or none at all: leave every one empty in local dev
# and uploads are disabled, with room types falling back to the CSS gradient.
# A *partial* set is refused at boot rather than at the first upload.
#
# For Cloudflare R2:
#   MEDIA_ENDPOINT      https://<account-id>.r2.cloudflarestorage.com
#   MEDIA_BUCKET        the bucket name
#   MEDIA_ACCESS_KEY_ID / MEDIA_SECRET_ACCESS_KEY
#                       an R2 API token scoped to Object Read & Write on that
#                       bucket only — never an account-wide token
#   MEDIA_PUBLIC_BASE_URL
#                       the bucket's public origin: its r2.dev domain, or a
#                       custom domain in front of it. This is the only one that
#                       is public; the other four are secrets.
#
# The bucket also needs CORS allowing PUT from the web origin, or the browser
# will refuse the direct upload. That is bucket configuration, not application
# config, so it is not represented here.
#
# MEDIA_ENDPOINT is the account endpoint and NOTHING after it. R2's S3 API is
# path-style, so the first segment after the host is read as the bucket — put
# "/<bucket>" here as well and the SDK sends MEDIA_BUCKET as the first segment
# of the object *key* instead. Every upload then lands one path segment away
# from where the database says it is, the PUT still reports success, and the
# photographs simply 404 on the site. That happened on this project; see
# docs/project-status.md.
MEDIA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_BUCKET=<bucket-name>
MEDIA_ACCESS_KEY_ID=<r2-access-key-id>
MEDIA_SECRET_ACCESS_KEY=<r2-secret-access-key>
MEDIA_PUBLIC_BASE_URL=
# R2 ignores the region but the S3 protocol requires one. Leave as "auto" for
# R2; set a real region (e.g. me-central-1) on AWS.
MEDIA_REGION=auto
# Largest single upload, in bytes. Room photography, not video.
MEDIA_MAX_UPLOAD_BYTES=10485760
