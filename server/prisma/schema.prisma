// Cove Dubai — Phase 1 reservation schema.
//
// This models the domain the way the hospitality industry does — room types,
// rate plans, reservations, guests — rather than the way our current screens
// happen to look. That is what makes it portable to whichever PMS the client
// eventually chooses (see the `pms-readiness` skill). No vendor is named
// anywhere in here, because no vendor has been chosen.
//
// Two conventions that matter:
//
//   * Localized text is stored as paired columns (`nameEn` / `nameAr`), not as
//     a translation table, so the admin can edit both languages on one screen
//     and neither language can silently go missing.
//   * `externalRef` exists on the entities a PMS would own. It is unused in
//     Phase 1 and deliberately nullable, so Phase 2 can record the PMS's own
//     identifiers without a schema migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// A bookable category of room. PMS platforms sell by type and count rather
/// than by individual room, so the room type — not a physical room — is the
/// booking unit here. Physical room allocation is a housekeeping concern and
/// is deliberately out of scope for Phase 1.
model RoomType {
  id String @id @default(cuid())

  /// Stable, human-readable identifier used in URLs and the API instead of the
  /// database id (`studio-room`, `cove-suite`). Internal ids are never exposed.
  code String @unique

  nameEn String
  nameAr String

  /// Marketing category shown above the room name ("Classic", "Signature").
  categoryEn String
  categoryAr String

  descriptionEn String
  descriptionAr String

  /// Nightly rate in AED before fees and tax. This is the fallback used when no
  /// RatePlan covers a given date.
  baseRateAed Decimal @db.Decimal(10, 2)

  maxOccupancy Int
  /// Rooms of this type the hotel owns. Seeds RoomTypeInventory.totalRooms; the
  /// per-date rows are authoritative once created, so a closure or maintenance
  /// block on one date does not require changing this.
  totalRooms   Int

  /// Identifies the CSS treatment in the mockups (`img-suite`, `img-terrace`).
  /// The mockups are image-free and render rooms with CSS, so this is a style
  /// key rather than an asset path. Becomes a real image when the client
  /// supplies photography.
  imageKey String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratePlans     RatePlan[]
  inventory     RoomTypeInventory[]
  reservations  Reservation[]
  amenities     RoomTypeAmenity[]
  voucherLimits VoucherRoomType[]
  images        RoomTypeImage[]

  @@index([isActive, sortOrder])
  @@map("room_types")
}

/// What a room type comes with — air conditioning, a safe, a balcony.
///
/// Modelled as its own table against a standard vocabulary rather than as prose
/// in the front-end, because room amenities are one of the few things in
/// hospitality with a genuine published standard. `otaCode` holds the
/// OpenTravel **RMA (Room Amenity Type)** code, which is what channel managers,
/// OTAs and PMS platforms exchange (Booking.com's connectivity API consumes
/// exactly this list). That makes the set portable to whichever PMS the client
/// eventually picks: mapping becomes a lookup rather than re-entering the data.
///
/// The prose specs — "Soaking tub & rain shower", floor ranges — deliberately
/// stay in the message files. Those are marketing copy with no standard behind
/// them, and the reasoning in docs/project-status.md still holds for them.
model Amenity {
  id String @id @default(cuid())

  /// Our own stable slug, used in the API and admin URLs (`air-conditioning`).
  code String @unique

  /// OpenTravel RMA code, e.g. 2 = Air conditioning, 92 = Safe, 5017 = Balcony.
  /// Nullable on purpose: the hotel can add an amenity the standard has no code
  /// for without being blocked, exactly like `externalRef` elsewhere.
  otaCode Int?

  nameEn String
  nameAr String

  category AmenityCategory @default(COMFORT)

  /// Optional icon key for the front-end. Like `imageKey`, a style key rather
  /// than an asset path.
  iconKey String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes RoomTypeAmenity[]

  @@index([isActive, sortOrder])
  @@map("amenities")
}

/// Grouping for display. Guests scan a room's amenities by kind rather than
/// reading one long list.
enum AmenityCategory {
  BATHROOM
  COMFORT
  TECHNOLOGY
  SERVICES
  ACCESSIBILITY
}

/// Which amenities a room type has.
///
/// A join table rather than an array column or a comma-separated string, so the
/// question "which room types have a balcony" is an index lookup, and so a
/// future channel-manager export can select per room type without parsing.
model RoomTypeAmenity {
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roomTypeId, amenityId])
  @@index([amenityId])
  @@map("room_type_amenities")
}

/// A nightly rate for a room type, optionally limited to a date window so
/// seasonal pricing is data rather than code. Where windows overlap, the
/// narrower (higher `priority`) plan wins.
model RatePlan {
  id String @id @default(cuid())

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  nameEn String
  nameAr String

  /// Marketing copy, set only on plans the hotel advertises as an offer.
  descriptionEn String?
  descriptionAr String?

  nightlyRateAed Decimal @db.Decimal(10, 2)

  /// Null on both sides means "the default plan, always applicable".
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// Which nights of the week this plan prices, as **0 = Sunday … 6 = Saturday**.
  ///
  /// A season alone cannot express what a hotel actually charges. Dubai city
  /// hotels price Thursday, Friday and Saturday nights above midweek, and that
  /// pattern repeats inside every season — so without this, "weekend rate" would
  /// mean hand-creating one dated plan per weekend, forever.
  ///
  /// A *night* belongs to the day it is slept on, not the day the guest checks
  /// out: a Thursday-to-Saturday stay is two nights, Thursday and Friday.
  ///
  /// The numbering matches JavaScript's `Date.getUTCDay()` deliberately, because
  /// the calendar and the inventory ledger already use it. ISO-8601's 1 = Monday
  /// would be more standard in isolation and would guarantee that someone
  /// eventually applies a rate to the wrong night.
  ///
  /// Defaults to all seven, so a plan that says nothing about days behaves
  /// exactly as it did before this column existed. A CHECK constraint in the
  /// migration forbids the empty array — "no days" must be impossible rather
  /// than quietly meaning "every day", which is the failure mode that would
  /// silently misprice a room.
  daysOfWeek Int[] @default([0, 1, 2, 3, 4, 5, 6])

  minimumStayNights Int @default(1)

  /// Higher wins when several plans cover the same night.
  priority Int     @default(0)
  isActive Boolean @default(true)

  /// Advertise this plan as an **offer** on the public site.
  ///
  /// An offer is not a separate concept from a rate plan — it *is* one, with
  /// marketing copy attached and a flag saying the hotel wants it seen. Modelling
  /// it any other way would mean a second pricing path competing with the one
  /// that is already tested, and two places for a nightly rate to disagree.
  isPublicOffer Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomTypeId, isActive, startDate, endDate])
  @@index([isPublicOffer, isActive])
  @@map("rate_plans")
}

/// The per-date inventory ledger — the heart of the double-booking guard.
///
/// One row per room type per night, tracking how many of that type exist and
/// how many are already sold. Creating a reservation increments `bookedRooms`
/// for every night of the stay inside a single transaction; a CHECK constraint
/// (added by hand in the migration, since Prisma's schema language cannot
/// express one) enforces `0 <= bookedRooms <= totalRooms`.
///
/// That constraint is the actual guarantee against overselling. Application
/// level availability checks are user experience only — two guests racing for
/// the last room are separated by the database, not by our code.
///
/// A Postgres EXCLUDE constraint over overlapping date ranges would be the
/// usual instinct here, but it can only express "this one room is taken"; it
/// cannot express "at most 12 of this type on this night". Hence the ledger.
model RoomTypeInventory {
  id String @id @default(cuid())

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  /// The night being sold. A stay of 3 nights touches 3 rows.
  date DateTime @db.Date

  totalRooms  Int
  bookedRooms Int @default(0)

  /// Lets the hotel close a date for maintenance without deleting the row or
  /// losing its booking count.
  isClosed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_type_inventory")
}

// ---------------------------------------------------------------------------
// Guests and reservations
// ---------------------------------------------------------------------------

/// A guest profile, carrying the fields any PMS expects. Nationality and
/// identity-document fields are captured as optional now because compliance
/// reporting will require them under whatever PMS is chosen — adding them later
/// would mean migrating live guest data.
model Guest {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String
  phone     String

  nationality      String?
  idDocumentType   String?
  idDocumentNumber String?

  /// Language the guest booked in — drives which email template they receive.
  preferredLocale Locale @default(EN)

  /// Reserved for a future PMS's own guest identifier. Unused in Phase 1.
  externalRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@index([email])
  @@index([lastName, firstName])
  @@map("guests")
}

model Reservation {
  id String @id @default(cuid())

  /// The public identity of this booking — human-friendly and non-sequential
  /// (`CV-2026-4821`). Used in URLs, emails, and the admin UI. Uniqueness is
  /// guaranteed here by the database, never by the process that generates it.
  bookingReference String @unique

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id])

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  /// First night. Inclusive.
  checkIn  DateTime @db.Date
  /// Departure day. Exclusive — a 12th-to-14th booking occupies 2 nights.
  checkOut DateTime @db.Date

  adults     Int @default(1)
  children   Int @default(0)
  roomsCount Int @default(1)

  status ReservationStatus @default(CONFIRMED)

  specialRequests String?
  /// Staff-only notes, never shown to the guest.
  internalNotes   String?

  /// The full price breakdown as computed at the moment of booking — room
  /// total, Tourism Dirham, VAT, grand total. Snapshotted rather than
  /// recomputed so that a later rate or tax change can never rewrite a total
  /// the guest has already been quoted and emailed.
  priceBreakdown Json
  /// Grand total from that snapshot, denormalised for reporting and sorting.
  totalAmountAed Decimal @db.Decimal(10, 2)
  currency       String  @default("AED")

  /// Single-use secret behind the guest's cancellation link. The link is keyed
  /// to this, never to an internal id.
  cancellationToken String? @unique

  /// Reserved for a future PMS's own reservation identifier. Unused in Phase 1.
  externalRef String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  /// At most one — a booking cannot stack discount codes.
  voucherRedemption VoucherRedemption?

  @@index([checkIn, checkOut])
  @@index([status, checkIn])
  @@index([roomTypeId, checkIn])
  @@map("reservations")
}

enum ReservationStatus {
  /// Held during an in-progress booking; inventory is committed but the guest
  /// has not finished. Phase 1 confirms immediately, so this is rare.
  HELD
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

enum Locale {
  EN
  AR
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

model AdminUser {
  id String @id @default(cuid())

  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

enum AdminRole {
  /// Full access, including managing other admin users.
  ADMIN
  /// Day-to-day reservation handling.
  STAFF
}

/// Append-only record of every administrative action, required by the
/// non-negotiable baseline in CLAUDE.md. Never updated or deleted.
model AuditLog {
  id String @id @default(cuid())

  /// Null for system-initiated actions (e.g. a guest self-cancelling).
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  action     String
  entityType String
  /// The affected record's identifier — a booking reference where one exists.
  entityId   String

  /// Before/after values, or whatever context makes the entry meaningful.
  details Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Guest accounts
// ---------------------------------------------------------------------------

/// An optional account a guest can create to see their own bookings.
///
/// **Deliberately separate from `Guest`.** A `Guest` row is a profile captured
/// at booking time and its email is *not* unique — a hotel legitimately has
/// several guests sharing a family address, and the same person books more than
/// once. An account is a login, and its email must be unique. Joining the two
/// on email at read time keeps both facts true: one account can see every
/// booking made with its address, without rewriting history or merging guests.
///
/// Booking never requires an account. The launch model is a guest flow that
/// works for someone who has never been here and never will again.
model GuestAccount {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  preferredLocale Locale @default(EN)

  /// Null until the guest follows the link in their verification email. An
  /// unverified account can sign in but cannot see bookings — otherwise
  /// anyone could register a stranger's address and read their stays.
  emailVerifiedAt DateTime?

  lastLoginAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens GuestAccountToken[]

  @@map("guest_accounts")
}

/// A single-use token for verifying an address or resetting a password.
///
/// Stored hashed, exactly as a password would be. These arrive by email and
/// grant access; a leaked database backup should not hand over live links.
model GuestAccountToken {
  id String @id @default(cuid())

  accountId String
  account   GuestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token that was emailed. The plaintext is never stored.
  tokenHash String @unique

  purpose GuestTokenPurpose

  expiresAt DateTime
  /// Set the moment it is spent, so a link cannot be replayed.
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([accountId, purpose])
  @@index([expiresAt])
  @@map("guest_account_tokens")
}

enum GuestTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

/// A discount code a guest types at booking.
///
/// Two rules from the `booking-engine` skill shape this model, and both are
/// easy to get wrong:
///
///   1. **A discount reduces the accommodation charge only.** VAT is therefore
///      calculated on the *discounted* room total, while the Tourism Dirham is
///      a fixed per-room-per-night government fee and is never discounted.
///   2. **Redemption limits are enforced by the database.** `redemptionCount`
///      is incremented inside the same transaction that writes the booking, and
///      a CHECK constraint makes exceeding `maxRedemptions` impossible. This is
///      the same guarantee the inventory ledger gives against overselling —
///      two guests racing for the last use of a single-use code cannot both win.
model Voucher {
  id String @id @default(cuid())

  /// Stored uppercase and matched case-insensitively — guests type these off a
  /// printed card or an email and the case is never reliable.
  code String @unique

  /// Shown to the guest on the summary line, so it needs both languages.
  nameEn String
  nameAr String

  discountType  DiscountType
  /// A percentage (0–100) or a fixed amount in AED, per `discountType`.
  discountValue Decimal      @db.Decimal(10, 2)

  /// Null on either side means unbounded in that direction.
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date

  /// Null means unlimited. Otherwise the CHECK constraint enforces it.
  maxRedemptions  Int?
  redemptionCount Int  @default(0)

  /// Stay requirements the booking must meet for the code to apply.
  minimumNights Int      @default(1)
  minimumSpend  Decimal? @db.Decimal(10, 2)

  /// Empty means "any room type"; otherwise the code only applies to these.
  roomTypes VoucherRoomType[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions VoucherRedemption[]

  @@index([isActive, validFrom, validTo])
  @@map("vouchers")
}

enum DiscountType {
  /// A percentage off the accommodation charge.
  PERCENTAGE
  /// A fixed number of AED off the accommodation charge.
  FIXED_AMOUNT
}

/// Restricts a voucher to particular room types. No rows means no restriction.
model VoucherRoomType {
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([voucherId, roomTypeId])
  @@index([roomTypeId])
  @@map("voucher_room_types")
}

/// One use of a voucher, written atomically with the reservation.
///
/// The amount is recorded here as well as in the reservation's price snapshot,
/// so "what has this campaign cost us" is a query rather than a reconstruction.
model VoucherRedemption {
  id String @id @default(cuid())

  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id])

  /// One redemption per reservation — a booking cannot stack codes.
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// AED taken off the accommodation charge.
  discountAed Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
  @@map("voucher_redemptions")
}

/// Server-side admin sessions, backing `express-session`.
///
/// Sessions live in Postgres rather than in process memory for two reasons:
/// Railway restarts containers freely and an in-memory store would log every
/// admin out on each deploy, and a session that exists only in one process
/// cannot be revoked or survive running more than one instance.
model AdminSession {
  /// express-session's own session id, which is the value in the cookie.
  sid String @id

  /// The serialized session payload, owned by express-session.
  data String

  /// Absolute row expiry, refreshed on each request to implement the idle
  /// timeout. Indexed so the periodic sweep of dead rows stays cheap.
  expiresAt DateTime

  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Operational values that must be changeable without a deploy — the Tourism
/// Dirham amount and the VAT rate in particular. The booking-engine skill is
/// explicit that these are configuration, not magic numbers in code.
model Setting {
  key         String @id
  value       String
  description String

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

/// An uploaded image, held in object storage.
///
/// The row records **where** the bytes are and **what they mean**; the bytes
/// themselves live in a bucket (see `src/media/storage.ts`). Postgres is a poor
/// place for binary blobs — it bloats backups and cannot be put behind a CDN —
/// and the performance baseline in CLAUDE.md asks for images served from one.
model MediaAsset {
  id String @id @default(cuid())

  /// The object key inside the bucket, e.g. `room-types/<uuid>.webp`.
  ///
  /// **A key, never an absolute URL.** The public origin is configuration
  /// (`MEDIA_PUBLIC_BASE_URL`), applied when the row is read. That is what
  /// makes moving Cloudflare R2 -> S3 + CloudFront one environment variable
  /// rather than a migration rewriting every row.
  storageKey String @unique

  contentType String
  byteSize    Int

  /// Intrinsic pixel dimensions, measured in the browser before upload.
  ///
  /// Not decoration: without width and height the front-end cannot reserve the
  /// space before the image loads, and the page reflows as each one arrives.
  /// CLAUDE.md sets a CLS budget of 0.1, and unsized images are the single
  /// most common way to blow it.
  width  Int
  height Int

  /// Alt text in both languages.
  ///
  /// Required, not optional. WCAG 2.1 AA is non-negotiable here, and an
  /// optional field is one nobody fills in. Bilingual for the same reason every
  /// other piece of guest-visible content is (`arabic-rtl`) — an English alt
  /// attribute on the Arabic site is a broken experience for exactly the people
  /// relying on it.
  ///
  /// A purely decorative image would take an empty string, which is the correct
  /// alt value for one, rather than a NULL that means "nobody decided".
  altEn String
  altAr String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes RoomTypeImage[]

  @@map("media_assets")
}

/// Which images belong to a room type, and in what order.
///
/// A join table rather than a column on RoomType, because a room type has a
/// gallery rather than a picture, and the same asset can legitimately appear on
/// more than one room type.
///
/// **The primary image is the lowest `sortOrder`**, not a boolean flag. An
/// `isPrimary` column needs a partial unique index to stop two rows both
/// claiming it, and still leaves "no primary at all" representable. Ordering
/// cannot express either broken state.
model RoomTypeImage {
  id String @id @default(cuid())

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  /// The same photograph twice in one gallery is always a mistake.
  @@unique([roomTypeId, assetId])
  @@index([roomTypeId, sortOrder])
  @@map("room_type_images")
}
