# Dependencies
node_modules/

# Environment — never commit real values (see .env.example in web/ and server/)
#
# `.env` on its own matches only that exact name. It does not match `.env.bak`,
# `.env.backup`, `.env.2026-09-16`, or whatever else someone reaches for when
# taking a quick copy before editing — and a copy of a .env is still a .env.
# One such file was committed on 16 Sep 2026 and only GitHub's push protection
# stopped it reaching the remote. Hence the wildcard, with the two checked-in
# templates named back in.
.env
.env.*
!.env.example

# Local credential notes. Anything named *.local.md holds real passwords and
# stays on the machine that wrote it — see docs/admin-access.md for the
# committed, secret-free version.
*.local.md

# Build output
.next/
out/
dist/
build/

# Test / tooling artefacts
coverage/
playwright-report/
test-results/
.playwright/

# Editor / OS
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# Playwright
/web/test-results/
/web/playwright-report/
